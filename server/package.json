{
  "name": "applyr-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/db/migrations',{recursive:true}); require('fs').readdirSync('src/db/migrations').forEach(f=>require('fs').copyFileSync('src/db/migrations/'+f,'dist/db/migrations/'+f));\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.8.1",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.57.0"
  }
}
