{
  "name": "applyr-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/db/migrations',{recursive:true}); require('fs').readdirSync('src/db/migrations').forEach(f=>require('fs').copyFileSync('src/db/migrations/'+f,'dist/db/migrations/'+f));\""
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.8.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
